<Window x:Class="percentagToAmp.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:percentagToAmp"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="#80000000"   
        ShowInTaskbar="False"
        Topmost="True">
    <Grid>
        <Border CornerRadius="12" Padding="24" Background="#CCFFFFFF"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,120,0,0">
            <StackPanel>
                <TextBlock Text="正在自動控制，請勿操作滑鼠鍵盤"
                           FontSize="20" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="กำลังควบคุมอัตโนมัติ กรุณาอย่าใช้เมาส์หรือคีย์บอร์ด"
            FontSize="20" FontWeight="Bold"
            HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="（約需數十秒）" Opacity="0.7"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="（ใช้เวลาประมาณไม่กี่สิบวินาที）" Opacity="0.7"
           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
